{
  "name": "Universal_Button",
  "version": "2.0.1",
  "description": "Debounced multi-button input with explicit reader validity, preserved interaction events, long-hold state, synchronized recovery and optional latching.",
  "keywords": [
    "button",
    "debounce",
    "short-press",
    "long-press",
    "double-click",
    "event-queue",
    "latching",
    "gpio",
    "mcp23017",
    "esp32",
    "esp32-s3",
    "arduino"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Little Man Builds (Darren Osborne)",
      "email": "littlemanbuilds@gmail.com",
      "maintainer": true
    }
  ],
  "homepage": "https://github.com/LittleManBuilds/Universal_Button",
  "repository": {
    "type": "git",
    "url": "https://github.com/LittleManBuilds/Universal_Button.git"
  },
  "frameworks": "arduino",
  "platforms": [
    "atmelavr",
    "atmelmegaavr",
    "atmelsam",
    "espressif32",
    "espressif8266",
    "raspberrypi",
    "ststm32",
    "teensy"
  ],
  "headers": [
    "Universal_Button.h"
  ],
  "build": {
    "includeDir": "src"
  },
  "examples": [
    "examples/01_BasicButton/01_BasicButton.ino",
    "examples/02_PressType/02_PressType.ino",
    "examples/03_LocalEnum/03_LocalEnum.ino",
    "examples/04_PortExpander/04_PortExpander.ino",
    "examples/05_CachedRead/05_CachedRead.ino",
    "examples/06_Latching/06_Latching.ino"
  ]
}
